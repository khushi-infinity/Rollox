<style>
  .levels-root {
    flex-direction: column;
    width: 600px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 22px;
    padding-right: 22px;
    gap: 11px;
    background-color: #101726;
    border-color: #3b4b6b;
    border-width: 2px;
    border-radius: 24px;
  }
  .header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  .heading {
    color: #fde047;
    font-size: 27px;
    font-weight: 700;
  }
  .sub {
    color: #94a3b8;
    font-size: 14px;
    line-height: 18px;
  }
  .level-card {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 11px;
    padding-bottom: 11px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: #182338;
    border-color: #2f405f;
    border-width: 2px;
    border-radius: 15px;
    gap: 10px;
  }
  .level-meta {
    flex-direction: column;
    gap: 3px;
    flex-grow: 1;
  }
  .level-title-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }
  .level-name {
    color: #f8fafc;
    font-size: 17px;
    font-weight: 700;
  }
  .level-status {
    color: #38bdf8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
  }
  .level-desc {
    color: #94a3b8;
    font-size: 13px;
  }
  .level-right {
    flex-direction: row;
    align-items: center;
    gap: 12px;
  }
  .stars {
    color: #fbbf24;
    font-size: 16px;
    font-weight: 700;
    width: 42px;
    text-align: center;
  }
  .lvl-btn {
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 16px;
    padding-right: 16px;
  }
</style>
<Panel class="levels-root">
  <div class="header-row">
    <div class="heading">SELECT LEVEL</div>
    <Button id="levels-back" class="lvl-btn">
      <ButtonIcon><ChevronLeft></ChevronLeft></ButtonIcon>
      <ButtonLabel>Back</ButtonLabel>
    </Button>
  </div>
  <div class="sub">Select any unlocked level to start bowling immediately. Complete a level to unlock the next.</div>

  <div id="lvl-card-0" class="level-card">
    <div class="level-meta">
      <div class="level-title-row">
        <span id="lvl-name-0" class="level-name">1. Meadow Straight</span>
        <span id="lvl-status-0" class="level-status">CURRENT</span>
      </div>
      <span id="lvl-best-0" class="level-desc">Classic Miniature Alley | Best: 0</span>
    </div>
    <div class="level-right">
      <span id="lvl-stars-0" class="stars">---</span>
      <Button id="btn-lvl-0" class="lvl-btn"><ButtonLabel id="btn-lvl-label-0">Play</ButtonLabel></Button>
    </div>
  </div>

  <div id="lvl-card-1" class="level-card">
    <div class="level-meta">
      <div class="level-title-row">
        <span id="lvl-name-1" class="level-name">2. Serpent Zigzag</span>
        <span id="lvl-status-1" class="level-status">LOCKED</span>
      </div>
      <span id="lvl-best-1" class="level-desc">Angled Bank Curves | Best: 0</span>
    </div>
    <div class="level-right">
      <span id="lvl-stars-1" class="stars">---</span>
      <Button id="btn-lvl-1" class="lvl-btn"><ButtonLabel id="btn-lvl-label-1">Locked</ButtonLabel></Button>
    </div>
  </div>

  <div id="lvl-card-2" class="level-card">
    <div class="level-meta">
      <div class="level-title-row">
        <span id="lvl-name-2" class="level-name">3. Skybridge Ramp</span>
        <span id="lvl-status-2" class="level-status">LOCKED</span>
      </div>
      <span id="lvl-best-2" class="level-desc">Elevated Crest &amp; Drop | Best: 0</span>
    </div>
    <div class="level-right">
      <span id="lvl-stars-2" class="stars">---</span>
      <Button id="btn-lvl-2" class="lvl-btn"><ButtonLabel id="btn-lvl-label-2">Locked</ButtonLabel></Button>
    </div>
  </div>

  <div id="lvl-card-3" class="level-card">
    <div class="level-meta">
      <div class="level-title-row">
        <span id="lvl-name-3" class="level-name">4. Dwarf's Crossing</span>
        <span id="lvl-status-3" class="level-status">LOCKED</span>
      </div>
      <span id="lvl-best-3" class="level-desc">Mind the Shield Guardian | Best: 0</span>
    </div>
    <div class="level-right">
      <span id="lvl-stars-3" class="stars">---</span>
      <Button id="btn-lvl-3" class="lvl-btn"><ButtonLabel id="btn-lvl-label-3">Locked</ButtonLabel></Button>
    </div>
  </div>

  <div id="lvl-card-4" class="level-card">
    <div class="level-meta">
      <div class="level-title-row">
        <span id="lvl-name-4" class="level-name">5. Crown Gauntlet</span>
        <span id="lvl-status-4" class="level-status">LOCKED</span>
      </div>
      <span id="lvl-best-4" class="level-desc">Ramp, Spinner &amp; Guardian | Best: 0</span>
    </div>
    <div class="level-right">
      <span id="lvl-stars-4" class="stars">---</span>
      <Button id="btn-lvl-4" class="lvl-btn"><ButtonLabel id="btn-lvl-label-4">Locked</ButtonLabel></Button>
    </div>
  </div>
</Panel>
