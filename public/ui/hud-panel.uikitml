<style>
  .hud-root {
    flex-direction: column;
    width: 680px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    gap: 10px;
    background-color: #0f172a;
    border-color: #334155;
    border-width: 2px;
    border-radius: 20px;
  }
  .top-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  .level-info {
    flex-direction: column;
    gap: 2px;
  }
  .level-title {
    color: #fde047;
    font-size: 22px;
    font-weight: 700;
    line-height: 26px;
  }
  .level-hint {
    color: #cbd5e1;
    font-size: 13px;
    line-height: 17px;
  }
  .stats-row {
    flex-direction: row;
    gap: 12px;
  }
  .stat-pill {
    flex-direction: column;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: #1e293b;
    border-color: #334155;
    border-width: 1px;
    border-radius: 12px;
  }
  .stat-label {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 700;
  }
  .stat-value {
    color: #f8fafc;
    font-size: 18px;
    font-weight: 700;
  }
  .power-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: #162033;
    border-radius: 10px;
  }
  .power-text {
    color: #7dd3fc;
    font-size: 13px;
    font-weight: 700;
    width: 320px;
  }
  .bar-track {
    flex-grow: 1;
    height: 10px;
    background-color: #0b1120;
    border-radius: 5px;
    border-color: #334155;
    border-width: 1px;
  }
  .bar-fill {
    width: 0px;
    height: 8px;
    background-color: #4ade80;
    border-radius: 4px;
  }
  .grab-state {
    color: #e2e8f0;
    font-size: 12px;
    font-weight: 600;
    width: 96px;
    text-align: right;
  }
  .actions-row {
    flex-direction: row;
    gap: 8px;
    justify-content: space-between;
  }
  .hud-btn {
    flex-grow: 1;
    justify-content: center;
    padding-top: 8px;
    padding-bottom: 8px;
  }
</style>
<Panel class="hud-root">
  <div class="top-row">
    <div class="level-info">
      <div id="hud-level-name" class="level-title">Meadow Straight</div>
      <div id="hud-level-hint" class="level-hint">Pinch ball, pull back, aim sideways, release!</div>
    </div>
    <div class="stats-row">
      <div class="stat-pill">
        <span class="stat-label">PINS</span>
        <span id="hud-pins-val" class="stat-value">0 / 10</span>
      </div>
      <div class="stat-pill">
        <span class="stat-label">SHOTS</span>
        <span id="hud-shots-val" class="stat-value">3 / 3</span>
      </div>
      <div class="stat-pill">
        <span class="stat-label">SCORE</span>
        <span id="hud-score-val" class="stat-value">0</span>
      </div>
    </div>
  </div>
  <div class="power-row">
    <span id="hud-power-text" class="power-text">READY TO BOWL</span>
    <div class="bar-track">
      <div id="hud-power-fill" class="bar-fill"></div>
    </div>
    <span id="hud-grab-state" class="grab-state">IDLE</span>
  </div>
  <div class="actions-row">
    <Button id="hud-reset-ball" class="hud-btn">
      <ButtonIcon><RotateCcw></RotateCcw></ButtonIcon>
      <ButtonLabel>Reset Ball</ButtonLabel>
    </Button>
    <Button id="hud-retry-level" class="hud-btn">
      <ButtonIcon><RefreshCw></RefreshCw></ButtonIcon>
      <ButtonLabel>Retry</ButtonLabel>
    </Button>
    <Button id="hud-recenter" class="hud-btn">
      <ButtonIcon><Crosshair></Crosshair></ButtonIcon>
      <ButtonLabel>Recenter</ButtonLabel>
    </Button>
    <Button id="hud-height-up" class="hud-btn">
      <ButtonIcon><ArrowUp></ArrowUp></ButtonIcon>
      <ButtonLabel>Higher</ButtonLabel>
    </Button>
    <Button id="hud-height-down" class="hud-btn">
      <ButtonIcon><ArrowDown></ArrowDown></ButtonIcon>
      <ButtonLabel>Lower</ButtonLabel>
    </Button>
    <Button id="hud-mute" class="hud-btn">
      <ButtonIcon><Volume2></Volume2></ButtonIcon>
      <ButtonLabel id="hud-mute-label">Sound</ButtonLabel>
    </Button>
    <Button id="hud-pause" class="hud-btn">
      <ButtonIcon><Pause></Pause></ButtonIcon>
      <ButtonLabel>Pause</ButtonLabel>
    </Button>
  </div>
</Panel>
