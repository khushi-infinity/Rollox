<style>
  .modal-root {
    flex-direction: column;
    width: 500px;
    padding-top: 22px;
    padding-bottom: 22px;
    padding-left: 24px;
    padding-right: 24px;
    gap: 12px;
    background-color: #0f172a;
    border-color: #fde047;
    border-width: 2px;
    border-radius: 24px;
  }
  .modal-eyebrow {
    color: #38bdf8;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-align: center;
  }
  .modal-title {
    color: #fde047;
    font-size: 30px;
    font-weight: 700;
    text-align: center;
  }
  .modal-stars {
    color: #fbbf24;
    font-size: 22px;
    font-weight: 700;
    text-align: center;
  }
  .banner-box {
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: #14532d;
    border-color: #4ade80;
    border-width: 1px;
    border-radius: 12px;
  }
  .banner-text {
    color: #ecfdf5;
    font-size: 14px;
    font-weight: 700;
    text-align: center;
  }
  .modal-summary {
    color: #e2e8f0;
    font-size: 15px;
    line-height: 21px;
    text-align: center;
  }
  .stats-grid {
    flex-direction: row;
    gap: 10px;
  }
  .stat-box {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: #182338;
    border-radius: 14px;
  }
  .stat-lbl {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 700;
  }
  .stat-val {
    color: #f8fafc;
    font-size: 19px;
    font-weight: 700;
  }
  .btn-col {
    flex-direction: column;
    gap: 10px;
  }
  .full-btn {
    width: 100%;
    padding-top: 11px;
    padding-bottom: 11px;
    justify-content: center;
  }
</style>
<Panel class="modal-root">
  <span id="modal-eyebrow" class="modal-eyebrow">RESULTS</span>
  <span id="modal-title" class="modal-title">STRIKE!</span>
  <span id="modal-stars" class="modal-stars">*** (3 / 3)</span>
  <div id="modal-banner-box" class="banner-box">
    <span id="modal-banner-text" class="banner-text">Level cleared - next challenge unlocked!</span>
  </div>
  <span id="modal-summary" class="modal-summary">Knocked 10 of 10 pins in 1 shot.</span>

  <div class="stats-grid">
    <div class="stat-box">
      <span class="stat-lbl">PINS KNOCKED</span>
      <span id="modal-pins-val" class="stat-val">10 / 10</span>
    </div>
    <div class="stat-box">
      <span class="stat-lbl">FINAL SCORE</span>
      <span id="modal-score-val" class="stat-val">150</span>
    </div>
    <div class="stat-box">
      <span id="modal-best-label" class="stat-lbl">BEST SCORE</span>
      <span id="modal-best-val" class="stat-val">150</span>
    </div>
  </div>

  <div class="btn-col">
    <Button id="modal-primary-btn" class="full-btn" style="background-color: #0284c7;">
      <ButtonIcon><Play></Play></ButtonIcon>
      <ButtonLabel id="modal-primary-label">Next Level</ButtonLabel>
    </Button>
    <Button id="modal-secondary-btn" class="full-btn">
      <ButtonIcon><RotateCcw></RotateCcw></ButtonIcon>
      <ButtonLabel id="modal-secondary-label">Play Again</ButtonLabel>
    </Button>
    <Button id="modal-settings-btn" class="full-btn">
      <ButtonIcon><Settings></Settings></ButtonIcon>
      <ButtonLabel>Settings &amp; Menu Size</ButtonLabel>
    </Button>
    <Button id="modal-tertiary-btn" class="full-btn">
      <ButtonIcon><List></List></ButtonIcon>
      <ButtonLabel id="modal-tertiary-label">Main Menu</ButtonLabel>
    </Button>
  </div>
</Panel>
