<style>
  .menu-root {
    flex-direction: column;
    width: 520px;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 26px;
    padding-right: 26px;
    gap: 14px;
    background-color: #101726;
    border-color: #3b4b6b;
    border-width: 2px;
    border-radius: 26px;
  }
  .brand-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  .brand-left {
    flex-direction: column;
    gap: 4px;
  }
  .eyebrow {
    color: #38bdf8;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }
  .title {
    color: #fde047;
    font-size: 40px;
    font-weight: 700;
    line-height: 44px;
  }
  .tagline {
    color: #e2e8f0;
    font-size: 15px;
    line-height: 20px;
  }
  .progress-box {
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 12px;
    background-color: #172554;
    border-color: #38bdf8;
    border-width: 1px;
  }
  .progress-text {
    color: #bae6fd;
    font-size: 13px;
    font-weight: 700;
  }
  .status-box {
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: #162033;
    border-color: #2b3a55;
    border-width: 1px;
    border-radius: 14px;
  }
  .status-text {
    color: #cbd5e1;
    font-size: 14px;
    font-weight: 600;
    line-height: 19px;
  }
  .menu-actions {
    flex-direction: column;
    gap: 12px;
  }
  .menu-btn {
    width: 100%;
    padding-top: 12px;
    padding-bottom: 12px;
    justify-content: center;
    background-color: #1e293b;
    color: #f8fafc;
  }
  .primary-btn {
    width: 100%;
    padding-top: 14px;
    padding-bottom: 14px;
    justify-content: center;
    background-color: #0284c7;
    color: #ffffff;
  }
  .custom-btn {
    width: 100%;
    padding-top: 12px;
    padding-bottom: 12px;
    justify-content: center;
    background-color: #b45309;
    color: #ffffff;
  }
  .btn-text-light {
    color: #f8fafc;
  }
</style>
<Panel class="menu-root">
  <div class="brand-row">
    <div class="brand-left">
      <div class="eyebrow">HANDS-FIRST MIXED-REALITY BOWLING</div>
      <div class="title">ROLLOX</div>
      <div class="tagline">Roll Beyond the Ordinary.</div>
    </div>
    <div class="progress-box">
      <span id="menu-progress-badge" class="progress-text">Cleared: 0 / 5</span>
    </div>
  </div>

  <div class="status-box">
    <span id="menu-xr-status" class="status-text">Checking WebXR Mixed Reality support...</span>
  </div>

  <div class="menu-actions">
    <Button id="btn-play" class="primary-btn">
      <ButtonIcon><Play></Play></ButtonIcon>
      <ButtonLabel class="btn-text-light">PLAY</ButtonLabel>
    </Button>
    <Button id="btn-custom-game" class="custom-btn">
      <ButtonIcon><Wrench></Wrench></ButtonIcon>
      <ButtonLabel class="btn-text-light">CUSTOM GAME</ButtonLabel>
    </Button>
    <Button id="btn-settings" class="menu-btn">
      <ButtonIcon><Settings></Settings></ButtonIcon>
      <ButtonLabel class="btn-text-light">SETTINGS</ButtonLabel>
    </Button>
    <Button id="btn-menu-xr" class="menu-btn">
      <ButtonIcon><RectangleGoggles></RectangleGoggles></ButtonIcon>
      <ButtonLabel id="btn-menu-xr-label" class="btn-text-light">ENTER MIXED REALITY</ButtonLabel>
    </Button>
  </div>
</Panel>
