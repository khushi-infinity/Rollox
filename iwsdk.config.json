{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/main.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "components": {
    "module": "./src/components"
  },
  "world": {
    "xr": {
      "mode": "ar",
      "offer": "always",
      "referenceSpace": {
        "type": "local-floor",
        "fallbackOrder": ["local", "viewer"]
      },
      "features": {
        "handTracking": true,
        "anchors": false,
        "planeDetection": true,
        "meshDetection": false,
        "hitTest": false,
        "depthSensing": {
          "usage": "gpu-optimized",
          "format": "float32"
        }
      }
    },
    "input": {
      "canvasPointerEvents": true
    },
    "render": {
      "fov": 68,
      "near": 0.01,
      "far": 100,
      "camera": {
        "position": [0, 1.48, 0.36],
        "lookAt": [0, 0.96, -0.82]
      }
    },
    "features": {
      "locomotion": false,
      "grabbing": false,
      "physics": false,
      "sceneUnderstanding": true,
      "environmentRaycast": false,
      "spatialUI": {
        "kit": "horizon",
        "preferredColorScheme": "dark"
      }
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "environment": "sunlit_living_room",
      "activation": "always"
    }
  }
}
